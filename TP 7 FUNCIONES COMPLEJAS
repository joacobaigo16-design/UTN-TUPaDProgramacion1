    print(f"{empleado}: {cantidad} vez/veces")

#----- Ejercicio 8 -----#

productos = {
    "Arroz": 10,
    "Fideos": 15,
    "Leche": 8,
    "Azúcar": 12
}

print("Stock actual:", productos)

producto = input("Ingresá el nombre del producto: ")

if producto in productos:
    print("Stock actual de", producto, ":", productos[producto])

    unidades = int(input("¿Cuántas unidades querés agregar? "))

    productos[producto] += unidades
    print("Stock actualizado:", productos[producto])

else:
    print("El producto no existe.")
    unidades = int(input("Ingresá la cantidad de unidades para el nuevo producto: "))

    productos[producto] = unidades
    print("Producto agregado correctamente.")

print("Stock final:", productos)


